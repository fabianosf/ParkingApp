# Copie para .env e preencha os valores locais:
#   copy .env.example .env
#
# O AMBIENTE principal fica em: ../ambiente.txt  (local | postgres | docker | production)
# Se DATABASE_URL estiver vazio aqui, o perfil do ambiente.txt decide o banco.

# Deixe vazio para usar o perfil do ambiente.txt
DATABASE_URL=

# === Supabase (opcional — só com valores reais) ===
SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_HOST=
SUPABASE_USE_POOLER=false
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

SECRET_KEY=change-me-in-production

# FRONTEND_URL / CORS são preenchidos pelo perfil se vazios
FRONTEND_URL=
CORS_ORIGINS=

MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# Defina ADMIN_CPF e ADMIN_SENHA no .env (obrigatório para o seed do admin)
ADMIN_CPF=
ADMIN_SENHA=CHANGE_ME_ADMIN_PASSWORD
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@parking.local
