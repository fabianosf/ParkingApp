# === Banco local (desenvolvimento) ===
DATABASE_URL=postgresql://parking:parking@localhost:5432/parking_db

# === Supabase (produção) ===
# Dashboard: Project Settings > API
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_PROJECT_REF=SEU_PROJECT_REF
SUPABASE_DB_PASSWORD=sua-senha-do-banco
# Região do pooler (ajuste se necessário): aws-0-sa-east-1, aws-0-us-east-1, etc.
SUPABASE_DB_HOST=aws-0-sa-east-1.pooler.supabase.com
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
SUPABASE_ANON_KEY=sb_publishable_...

# Se SUPABASE_PROJECT_REF + SUPABASE_DB_PASSWORD estiverem preenchidos,
# DATABASE_URL é ignorado e a conexão Supabase é usada automaticamente.

SECRET_KEY=dev-secret-key-change-in-production

MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# Admin inicial (criado automaticamente na 1ª subida da API, se não existir)
ADMIN_CPF=05721845732
ADMIN_SENHA=260281xx
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@parking.local
