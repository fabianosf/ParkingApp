# Copie para .env na raiz e preencha antes de: docker compose up --build
#   copy .env.docker.example .env

SECRET_KEY=change-me-in-production

FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

POSTGRES_PASSWORD=parking

# Defina ADMIN_CPF e ADMIN_SENHA no .env
ADMIN_CPF=
ADMIN_SENHA=CHANGE_ME_ADMIN_PASSWORD
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@parking.local

# Email (opcional — reset de senha)
